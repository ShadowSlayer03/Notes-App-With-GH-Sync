{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notes-app-with-gh-sync-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-07",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "queues": {
    "producers": [
      {
        "binding": "REPOSITORY_QUEUE",
        "queue": "repository-queue",
      },
      {
        "binding": "AI_QUEUE",
        "queue": "ai-queue",
      },
      {
        "binding": "MEDIA_QUEUE",
        "queue": "media-queue",
      },
    ],

    "consumers": [
      {
        "queue": "repository-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
      },
      {
        "queue": "ai-queue",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 3,
      },
      {
        "queue": "media-queue",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 3,
      },
    ],
  },
  "vars": {
    "BACKEND_MAIN_URI": "https://api.kairno.dev",
    "FRONTEND_MAIN_URI": "https://kairno.dev",
    "GITHUB_OAUTH_CLIENT_ID": "Ov23li0zrrgdqT9icgF4",
    "TURSO_DATABASE_URL": "libsql://kairno-notes-shadowslayer03.aws-ap-south-1.turso.io",
  }
}
