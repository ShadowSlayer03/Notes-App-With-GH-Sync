{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-07",

  "queues": {
    "producers": [
      {
        "binding": "REPOSITORY_QUEUE",
        "queue": "repository-queue"
      },
      {
        "binding": "AI_QUEUE",
        "queue": "ai-queue"
      },
      {
        "binding": "MEDIA_QUEUE",
        "queue": "media-queue"
      }
    ],

    "consumers": [
      {
        "queue": "repository-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      },
      {
        "queue": "ai-queue",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 3
      },
      {
        "queue": "media-queue",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  }
}